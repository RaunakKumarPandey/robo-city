# ==============================================================================
# ROBO CITY — RoboVerse'26 Environment Variables Template
# Copy this file to .env.local for local development.
# For Vercel production deployment, add these keys under Project Settings > Environment Variables.
# ==============================================================================

# 1. Supabase PostgreSQL & Auth Connection
# Obtain from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google Form / Google Apps Script Webhook Security
# Shared secret for HMAC-SHA256 request authentication.
# Must match the secret in Google Apps Script Script Properties (ROBO_WEBHOOK_SECRET).
# DO NOT PREFIX WITH NEXT_PUBLIC_ (Must remain server-side only).
GOOGLE_FORM_WEBHOOK_SECRET=your-secure-webhook-secret-here
# Optional alias:
# ROBO_WEBHOOK_SECRET=your-secure-webhook-secret-here
